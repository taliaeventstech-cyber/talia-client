{
  "name": "talia-client",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "security:audit": "npm audit --audit-level=high",
    "widget:smoke": "node scripts/check-widget-installation.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "db:migrate": "supabase db push",
    "db:types": "supabase gen types typescript --linked --schema public > src/types/database.types.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@splinetool/viewer": "^1.12.98",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.104.1",
    "csv-parse": "^7.0.2",
    "exceljs": "^4.4.0",
    "libphonenumber-js": "^1.13.11",
    "lucide-react": "^1.33.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.85.0",
    "recharts": "^3.10.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.19.39",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "supabase": "^2.95.3",
    "typescript": "^5",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "uuid": "^11.1.1",
    "next": {
      "sharp": "0.35.3"
    }
  }
}
